				<region region-id="27313" left="420" top="776.25" width="113.25" height="36" align-x="437.25" align-y="786" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">&lt;-- recuerde que en un equilibrio LV debe cumplir que:</p>
					</text>
				</region>
				<region region-id="27472" left="558" top="776.25" width="260.25" height="36" align-x="566.25" align-y="786" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<tab/>Otro tip a recordar es que el producto lo vectorizamos (---&gt;) porque de lo contrario la multiplicación nos devolvería un número escalar (51,574 en este caso):</p>
					</text>
				</region>
				<region region-id="27173" left="210" top="771.75" width="183.75" height="35.25" align-x="276" align-y="792" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:matcol/>
									<ml:id xml:space="preserve">f</ml:id>
									<ml:real>10</ml:real>
								</ml:apply>
								<ml:apply>
									<ml:vectorSum/>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">f</ml:id>
										<ml:real>7</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:vectorize/>
									<ml:parens>
										<ml:apply>
											<ml:mult/>
											<ml:id xml:space="preserve" subscript="LV.ideal">K</ml:id>
											<ml:apply>
												<ml:matcol/>
												<ml:id xml:space="preserve">f</ml:id>
												<ml:real>7</ml:real>
											</ml:apply>
										</ml:apply>
									</ml:parens>
								</ml:apply>
								<ml:apply>
									<ml:vectorSum/>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">f</ml:id>
										<ml:real>10</ml:real>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:apply>
					</math>
				</region>
				<region region-id="27316" left="450" top="819" width="55.5" height="18" align-x="462.75" align-y="828" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<math optimize="false" disable-calc="true">
						<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:equal/>
