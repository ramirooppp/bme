											<ml:apply>
												<ml:indexer/>
												<ml:id xml:space="preserve">producto</ml:id>
												<ml:id xml:space="preserve">i</ml:id>
											</ml:apply>
											<ml:apply>
												<ml:mult/>
												<ml:apply>
													<ml:indexer/>
													<ml:id xml:space="preserve">K</ml:id>
													<ml:id xml:space="preserve">i</ml:id>
