				<region region-id="27811" left="198" top="202.5" width="330" height="48" align-x="208.5" align-y="212.25" show-border="false" show-highlight="true" is-protected="true" z-order="0" background-color="#ffff80" tag="">
					<text use-page-width="false" push-down="false" lock-width="true">
						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Como Kϕϕ proviene de una programación grande, no podemos vectorizar porque se va a meter dentro de la referencia y también va a querer vectorizar en cada paso rompiendo todo lo hecho en dicha referencia. Por eso programamos el producto vectorial elemento a elemento (EaE)</p>
					</text>
				</region>
				<region region-id="24070" left="6" top="268.5" width="183.75" height="62.25" align-x="138.75" align-y="302.25" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
					<math optimize="false" disable-calc="false">
						<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
							<ml:apply>
								<ml:id xml:space="preserve" subscript="LV.ϕϕ">K</ml:id>
								<ml:sequence>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">f</ml:id>
										<ml:real>7</ml:real>
									</ml:apply>
									<ml:apply>
										<ml:matcol/>
										<ml:id xml:space="preserve">f</ml:id>
										<ml:real>10</ml:real>
									</ml:apply>
									<ml:id xml:space="preserve" subscript="op">T</ml:id>
									<ml:id xml:space="preserve" subscript="op">P</ml:id>
								</ml:sequence>
							</ml:apply>
							<result xmlns="http://schemas.mathsoft.com/math30">
								<ml:matrix rows="4" cols="1">
