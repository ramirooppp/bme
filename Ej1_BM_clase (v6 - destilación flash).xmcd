						<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
							<b>
								<i>- Torre de destilacion flash (K1)</i>
							</b>
						</p>
					</text>
				</region>
				<region region-id="23271" left="18" top="93" width="74.25" height="15" align-x="38.25" align-y="102" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
