								<hash/>
							</parentRef>
							<comment xmlns="http://schemas.mathsoft.com/provenance10"/>
							<originComment xmlns="http://schemas.mathsoft.com/provenance10"/>
							<contentHash xmlns="http://schemas.mathsoft.com/provenance10">e274200f6680d59c2a692ed8e5f812b2</contentHash>
							<ml:define>
								<ml:function>
									<ml:id xml:space="preserve">EaE</ml:id>
									<ml:boundVars>
										<ml:id xml:space="preserve">K</ml:id>
										<ml:id xml:space="preserve">x</ml:id>
									</ml:boundVars>
								</ml:function>
								<ml:program>
									<ml:for>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:range>
											<ml:real>1</ml:real>
											<ml:apply>
												<ml:id xml:space="preserve">rows</ml:id>
												<ml:id xml:space="preserve">x</ml:id>
