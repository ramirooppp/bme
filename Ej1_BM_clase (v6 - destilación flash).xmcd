					<math optimize="false" disable-calc="false">
						<ml:provenance expr-id="1" xmlns:ml="http://schemas.mathsoft.com/math30">
							<originRef doc-id="5296E620-4271-4953-A7FD-F50ED1756CC4" version-id="146CFD45-69C5-4FFE-B766-6E6C8E54C589" branch-id="00000000-0000-0000-0000-000000000000" revision-num="230806556" is-modified="true" region-id="0" href="\\ciqa\IntegracionIII\2026\Guias\BM\Ej1_BM_clase (v5 - destilación flash HRM).xmcd" xmlns="http://schemas.mathsoft.com/provenance10">
