							</ns1:apply>
						</ns1:localDefine>
						<ns1:localDefine>
							<ns1:id xml:space="preserve">b</ns1:id>
							<ns1:apply>
								<ns1:mult />
								<ns1:real>0.0778</ns1:real>
								<ns1:apply>
									<ns1:div />
									<ns1:apply>
										<ns1:mult />
										<ns1:id xml:space="preserve" subscript="g">R</ns1:id>
