														</ns1:apply>
													</ns1:parens>
												</ns1:apply>
												<ns1:apply>
													<ns1:mult />
													<ns1:id xml:space="preserve" subscript="pm">Θ</ns1:id>
													<ns1:id xml:space="preserve" subscript="pm">B</ns1:id>
												</ns1:apply>
											</ns1:apply>
										</ns1:parens>
									</ns1:apply>
									<ns1:apply>
										<ns1:minus />
										<ns1:apply>
											<ns1:plus />
											<ns1:id xml:space="preserve" subscript="pm">Θ</ns1:id>
