		<region region-id="100" left="714" top="3501.0" width="600" height="996.75" align-x="820.5" align-y="3510.0" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ns1:define>
					<ns1:function>
						<ns1:id xml:space="preserve" subscript="L.PR">ϕ</ns1:id>
						<ns1:boundVars>
