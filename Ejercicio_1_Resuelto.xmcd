								<ns1:id xml:space="preserve" subscript="m">ε</ns1:id>
								<ns1:apply>
									<ns1:pow />
									<ns1:parens>
										<ns1:apply>
											<ns1:div />
											<ns1:id xml:space="preserve">P</ns1:id>
