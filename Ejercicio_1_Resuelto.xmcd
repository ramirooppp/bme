								</ns1:sequence>
							</ns1:apply>
						</math>
						<rendering item-idref="6" />
					</region> Fugacidad del componente i de la mezcla líquida</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Devuelven un vector (Nc x 1), bar</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit" />
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<tab />Uso:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<tab />
					<region region-id="402" left="924" top="1470.75" width="201.75" height="16.5" align-x="970.5" align-y="1479.75" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ns1:apply>
								<ns1:equal />
								<ns1:apply>
									<ns1:id xml:space="preserve" subscript="i">G</ns1:id>
									<ns1:sequence>
										<ns1:id xml:space="preserve">T</ns1:id>
										<ns1:id xml:space="preserve">P</ns1:id>
										<ns1:id xml:space="preserve">y</ns1:id>
									</ns1:sequence>
								</ns1:apply>
								<ns1:apply>
									<ns1:plus />
									<ns1:apply>
										<ns1:id xml:space="preserve" subscript="puro.i">G</ns1:id>
										<ns1:sequence>
											<ns1:id xml:space="preserve">T</ns1:id>
											<ns1:apply>
												<ns1:mult />
												<ns1:real>1</ns1:real>
												<ns1:id xml:space="preserve">bar</ns1:id>
											</ns1:apply>
											<ns1:id xml:space="preserve">gas</ns1:id>
										</ns1:sequence>
									</ns1:apply>
									<ns1:apply>
										<ns1:mult />
										<ns1:apply>
											<ns1:mult />
											<ns1:id xml:space="preserve">R</ns1:id>
											<ns1:id xml:space="preserve">T</ns1:id>
										</ns1:apply>
										<ns1:apply>
											<ns1:id xml:space="preserve">ln</ns1:id>
											<ns1:id xml:space="preserve" subscript="V.i">f</ns1:id>
										</ns1:apply>
									</ns1:apply>
								</ns1:apply>
							</ns1:apply>
						</math>
						<rendering item-idref="7" />
					</region>
				</p>
