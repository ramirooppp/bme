										</ns1:apply>
										<ns1:apply>
											<ns1:indexer />
											<ns1:id xml:space="preserve">z</ns1:id>
											<ns1:id xml:space="preserve">i</ns1:id>
										</ns1:apply>
									</ns1:localDefine>
									<ns1:localDefine>
										<ns1:id xml:space="preserve">k</ns1:id>
										<ns1:apply>
											<ns1:plus />
											<ns1:id xml:space="preserve">k</ns1:id>
											<ns1:real>1</ns1:real>
										</ns1:apply>
									</ns1:localDefine>
