							</ns1:apply>
						</ns1:localDefine>
						<ns1:localDefine>
							<ns1:id xml:space="preserve">a</ns1:id>
							<ns1:apply>
								<ns1:mult />
								<ns1:real>0.45724</ns1:real>
								<ns1:apply>
									<ns1:div />
									<ns1:apply>
										<ns1:pow />
										<ns1:parens>
											<ns1:apply>
												<ns1:mult />
												<ns1:id xml:space="preserve" subscript="g">R</ns1:id>
