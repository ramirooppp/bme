										</ns1:apply>
										<ns1:apply>
											<ns1:mult style="auto-select" />
											<ns1:id xml:space="preserve" subscript="pm">δ</ns1:id>
											<ns1:parens>
												<ns1:apply>
													<ns1:plus />
													<ns1:id xml:space="preserve" subscript="pm">B</ns1:id>
													<ns1:real>1</ns1:real>
												</ns1:apply>
											</ns1:parens>
										</ns1:apply>
