							</ns1:program>
						</ns1:ifThen>
						<ns1:localDefine>
							<ns1:id xml:space="preserve">y</ns1:id>
							<ns1:apply>
								<ns1:div />
								<ns1:id xml:space="preserve">y</ns1:id>
								<ns1:apply>
									<ns1:vectorSum />
									<ns1:id xml:space="preserve">y</ns1:id>
