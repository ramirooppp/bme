															<ns1:real>0.37464</ns1:real>
															<ns1:apply>
																<ns1:mult />
																<ns1:real>1.54226</ns1:real>
																<ns1:id xml:space="preserve">ω</ns1:id>
															</ns1:apply>
														</ns1:apply>
														<ns1:apply>
															<ns1:mult />
															<ns1:real>0.2699</ns1:real>
															<ns1:apply>
																<ns1:pow />
																<ns1:id xml:space="preserve">ω</ns1:id>
																<ns1:real>2</ns1:real>
															</ns1:apply>
														</ns1:apply>
													</ns1:apply>
												</ns1:parens>
												<ns1:parens>
													<ns1:apply>
														<ns1:minus />
														<ns1:real>1</ns1:real>
														<ns1:apply>
															<ns1:pow />
															<ns1:parens>
																<ns1:apply>
																	<ns1:div />
																	<ns1:id xml:space="preserve">T</ns1:id>
																	<ns1:id xml:space="preserve" subscript="c">T</ns1:id>
																</ns1:apply>
															</ns1:parens>
															<ns1:apply>
																<ns1:div />
																<ns1:real>1</ns1:real>
																<ns1:real>2</ns1:real>
															</ns1:apply>
														</ns1:apply>
													</ns1:apply>
												</ns1:parens>
											</ns1:apply>
										</ns1:apply>
									</ns1:parens>
									<ns1:real>2</ns1:real>
								</ns1:apply>
							</ns1:apply>
						</ns1:localDefine>
						<ns1:localDefine>
							<ns1:id xml:space="preserve">Θ</ns1:id>
							<ns1:apply>
								<ns1:vectorize />
								<ns1:parens>
									<ns1:apply>
										<ns1:mult />
