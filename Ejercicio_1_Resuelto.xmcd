							</ns1:apply>
						</ns1:localDefine>
						<ns1:for>
							<ns1:id xml:space="preserve">i</ns1:id>
							<ns1:range>
								<ns1:real>1</ns1:real>
								<ns1:id xml:space="preserve">I</ns1:id>
							</ns1:range>
							<ns1:for>
								<ns1:id xml:space="preserve">j</ns1:id>
								<ns1:range>
									<ns1:real>1</ns1:real>
									<ns1:id xml:space="preserve">I</ns1:id>
								</ns1:range>
								<ns1:localDefine>
									<ns1:apply>
										<ns1:indexer />
										<ns1:id xml:space="preserve">Θs</ns1:id>
										<ns1:sequence>
											<ns1:id xml:space="preserve">i</ns1:id>
											<ns1:id xml:space="preserve">j</ns1:id>
										</ns1:sequence>
									</ns1:apply>
									<ns1:apply>
										<ns1:pow />
										<ns1:parens>
											<ns1:apply>
												<ns1:mult />
												<ns1:apply>
													<ns1:indexer />
													<ns1:id xml:space="preserve">Θ</ns1:id>
													<ns1:id xml:space="preserve">i</ns1:id>
												</ns1:apply>
												<ns1:apply>
													<ns1:indexer />
