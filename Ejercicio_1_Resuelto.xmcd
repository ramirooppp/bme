									<ns1:id xml:space="preserve">P</ns1:id>
								</ns1:apply>
								<ns1:apply>
									<ns1:mult />
									<ns1:id xml:space="preserve" subscript="g">R</ns1:id>
									<ns1:id xml:space="preserve">T</ns1:id>
								</ns1:apply>
							</ns1:apply>
						</ns1:localDefine>
						<ns1:localDefine>
							<ns1:id xml:space="preserve" subscript="pm">δ</ns1:id>
							<ns1:apply>
								<ns1:div />
								<ns1:apply>
									<ns1:mult />
									<ns1:id xml:space="preserve" subscript="m">δ</ns1:id>
									<ns1:id xml:space="preserve">P</ns1:id>
								</ns1:apply>
								<ns1:apply>
									<ns1:mult />
									<ns1:id xml:space="preserve" subscript="g">R</ns1:id>
									<ns1:id xml:space="preserve">T</ns1:id>
