									<ns1:id xml:space="preserve">I</ns1:id>
								</ns1:bounds>
							</ns1:apply>
						</ns1:localDefine>
						<ns1:localDefine>
							<ns1:id xml:space="preserve" subscript="m">δ</ns1:id>
							<ns1:apply>
								<ns1:mult />
								<ns1:real>2</ns1:real>
