		<region region-id="109" left="30" top="3794.25" width="650.25" height="24" align-x="30" align-y="3804" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">C) Tabla comparativa de Potencial Económico e Inversión Total en Equipos en función de beta:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Columnas de la tabla: [ Fracción beta, PE [u$s/h], PE Anual [u$s/año], Inversión Total en Equipos [u$s] ]</p>
			</text>
		</region>
		<region region-id="110" left="30" top="3807.75" width="228.75" height="95.25" align-x="66" align-y="3858" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
