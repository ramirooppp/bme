		<region region-id="58" left="30" top="2010.75" width="650.25" height="54" align-x="30" align-y="2022" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4. CUADRO RESUMEN DE BALANCE DE MASA (INCISO A - BETA = 0.25)</p>
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">A continuación se presentan las matrices completas del balance de masa: flujos molares f, caudales molares totales F,</p>
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">fracciones molares x, flujos másicos w [kg/h], caudales másicos totales W [kg/h] y porcentajes en peso y [%p].</p>
			</text>
		</region>
		<region region-id="59" left="30" top="2084.25" width="650.25" height="12" align-x="30" align-y="2094" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">A) Matriz de flujos molares por componente f [kmol/h] (Filas: 1=DME, 2=MetOH, 3=Agua; Columnas: F1 a F9):</p>
			</text>
		</region>
		<region region-id="60" left="30" top="2101.5" width="441" height="51.75" align-x="40.5" align-y="2130" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">f</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:matrix rows="3" cols="9">
							<ml:real>0</ml:real>
							<ml:real>100</ml:real>
							<ml:real>0</ml:real>
							<ml:real>0.37109498084964426</ml:real>
							<ml:real>105.04435465048755</ml:real>
							<ml:real>0.0036833939394781811</ml:real>
							<ml:real>49.479330779952569</ml:real>
							<ml:real>6.8278830522816918</ml:real>
							<ml:real>49.111919193042404</ml:real>
