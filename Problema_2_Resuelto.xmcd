		<region region-id="33" left="30" top="1278.75" width="650.25" height="27" align-x="30" align-y="1290" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3. VECTORES DE FLUJOS MOLARES POR CORRIENTE [kmol/h]</p>
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Definimos cada vector de corriente f&lt;j&gt; como una columna de la matriz global f, aplicando los balances unitarios:</p>
			</text>
		</region>
		<region region-id="34" left="30" top="1334.25" width="650.25" height="12" align-x="30" align-y="1344" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
