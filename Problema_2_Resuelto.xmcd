		<region region-id="30" left="30" top="1239" width="76.5" height="16.5" align-x="47.25" align-y="1248" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="3">C</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:parens>
							<ml:apply>
								<ml:minus/>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve">β</ml:id>
							</ml:apply>
						</ml:parens>
						<ml:id xml:space="preserve" subscript="1">HK</ml:id>
