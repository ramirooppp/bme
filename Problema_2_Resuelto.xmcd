		<region region-id="39" left="180" top="1453.5" width="100.5" height="51.75" align-x="201.75" align-y="1482" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
