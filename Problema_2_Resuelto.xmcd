		<region region-id="37" left="30" top="1436.25" width="650.25" height="12" align-x="30" align-y="1446" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">- Corriente F2: Alimentación total al reactor R1 (F1 + F9):</p>
			</text>
		</region>
		<region region-id="38" left="30" top="1451.25" width="59.25" height="57" align-x="53.25" align-y="1482" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
