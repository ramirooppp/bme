		<region region-id="40" left="30" top="1538.25" width="650.25" height="12" align-x="30" align-y="1548" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">- Corriente F3: Salida del reactor R1 (f&lt;3&gt; = f&lt;2&gt; + nu * xi):</p>
			</text>
		</region>
		<region region-id="41" left="30" top="1569.75" width="74.25" height="18" align-x="53.25" align-y="1584" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
