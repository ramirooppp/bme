			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">B) Costo de inversión en equipos en el caso base (beta = 0.25):</p>
			</text>
		</region>
		<region region-id="101" left="30" top="3693.75" width="218.25" height="27.75" align-x="66" align-y="3714" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="R1">Cost</ml:id>
					<ml:apply>
						<ml:pow/>
						<ml:real>10</ml:real>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:minus/>
								<ml:real>4.2247</ml:real>
								<ml:apply>
									<ml:mult/>
									<ml:real>0.1430</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">log</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">F</ml:id>
											<ml:sequence>
												<ml:real>1</ml:real>
												<ml:real>2</ml:real>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0.1634</ml:real>
								<ml:apply>
									<ml:pow/>
									<ml:apply>
										<ml:id xml:space="preserve">log</ml:id>
										<ml:apply>
