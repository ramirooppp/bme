		<region region-id="103" left="348" top="3693.75" width="218.25" height="27.75" align-x="384" align-y="3714" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="T1">Cost</ml:id>
					<ml:apply>
						<ml:pow/>
						<ml:real>10</ml:real>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:minus/>
								<ml:real>3.7874</ml:real>
								<ml:apply>
									<ml:mult/>
									<ml:real>0.1085</ml:real>
									<ml:apply>
										<ml:id xml:space="preserve">log</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">F</ml:id>
											<ml:sequence>
												<ml:real>1</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:real>0.2434</ml:real>
								<ml:apply>
									<ml:pow/>
									<ml:apply>
										<ml:id xml:space="preserve">log</ml:id>
										<ml:apply>
											<ml:indexer/>
											<ml:id xml:space="preserve">F</ml:id>
											<ml:sequence>
												<ml:real>1</ml:real>
												<ml:real>3</ml:real>
											</ml:sequence>
										</ml:apply>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
