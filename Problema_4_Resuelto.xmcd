			</math>
			<rendering item-idref="34"/>
		</region>
		<region region-id="45" left="270" top="2115" width="53.25" height="16.5" align-x="286.5" align-y="2124" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
