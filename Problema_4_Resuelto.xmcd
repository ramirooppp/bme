		<region region-id="40" left="390" top="1977" width="67.5" height="36.75" align-x="411.75" align-y="1998" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
