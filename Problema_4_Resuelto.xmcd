		<region region-id="57" left="30" top="1928.25" width="650.25" height="36" align-x="30" align-y="1938" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">G) Requerimiento de Agua a la Entrada del Reactor (Componente 6):</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>La especificación operativa fija una relación molar Agua/Etileno = 0.6 a la entrada de R1:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>f&lt;2&gt;_6 := R_w * f&lt;2&gt;_2 [mol/h].</p>
			</text>
		</region>
		<region region-id="58" left="30" top="2001" width="60.75" height="16.5" align-x="51.75" align-y="2010" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="2.6">f</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:id xml:space="preserve" subscript="w">R</ml:id>
						<ml:id xml:space="preserve" subscript="2.2">f</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="45"/>
		</region>
		<region region-id="59" left="180" top="2001" width="54" height="16.5" align-x="200.25" align-y="2010" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
