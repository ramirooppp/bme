				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Alimentación fresca de gases F1 (100 mol/h: 0.1% inerte, 97% etileno, 2.9% acetileno):</p>
			</text>
		</region>
		<region region-id="25" left="30" top="1257" width="38.25" height="16.5" align-x="46.5" align-y="1266" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
