		<region region-id="156" left="30" top="8559" width="237.75" height="16.5" align-x="47.25" align-y="8568" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">PE</ml:id>
					<ml:apply>
						<ml:minus/>
