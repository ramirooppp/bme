		</region>
		<region region-id="56" left="402" top="2469" width="38.25" height="16.5" align-x="422.25" align-y="2478" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="2.5">f</ml:id>
