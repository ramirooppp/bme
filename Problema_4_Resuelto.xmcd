		<region region-id="42" left="30" top="1574.25" width="650.25" height="24" align-x="30" align-y="1584" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">D) Grados de avance de reacción (xi_1 y xi_2):</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>Por estequiometría de reactivos limitantes: xi_1 := chi_1 * f&lt;2&gt;_2<sp count="2"/>y<sp count="2"/>xi_2 := chi_2 * f&lt;2&gt;_3 [mol/h].</p>
			</text>
		</region>
		<region region-id="43" left="30" top="1629" width="53.25" height="16.5" align-x="46.5" align-y="1638" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1">ξ</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:id xml:space="preserve" subscript="1">χ</ml:id>
						<ml:id xml:space="preserve" subscript="2.2">f</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="33"/>
		</region>
		<region region-id="44" left="150" top="1629" width="53.25" height="16.5" align-x="165" align-y="1638" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="1">ξ</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>20.208333333333336</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="34"/>
		</region>
		<region region-id="45" left="270" top="1629" width="53.25" height="16.5" align-x="286.5" align-y="1638" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
