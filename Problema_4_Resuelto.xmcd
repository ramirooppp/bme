		<region region-id="46" left="390" top="1629" width="48.75" height="16.5" align-x="405" align-y="1638" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
