		<region region-id="47" left="510" top="1617" width="42.75" height="36.75" align-x="522" align-y="1638" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
