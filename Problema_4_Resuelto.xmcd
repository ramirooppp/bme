		<region region-id="10" left="30" top="974.25" width="650.25" height="12" align-x="30" align-y="984" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Parámetros de operación, conversiones de reactor y cortes de columnas (split = 0.01):</p>
			</text>
		</region>
