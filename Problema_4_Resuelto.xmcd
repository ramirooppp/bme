							<ml:id xml:space="preserve" subscript="2">ξ</ml:id>
						</ml:apply>
						<ml:parens>
							<ml:apply>
								<ml:minus/>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve" subscript="4">C</ml:id>
