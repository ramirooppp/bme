		<region region-id="102" left="30" top="4794.75" width="650.25" height="40.5" align-x="30" align-y="4806" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4. CUADRO RESUMEN DE BALANCE DE MASA (INCISO A - BETA_1 = 0.20)</p>
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Presentación rigurosa de matrices del balance: flujos molares f [mol/h], caudales molares totales F [mol/h],</p>
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">fracciones molares x, flujos másicos w [g/h], caudales másicos totales W [g/h] y composiciones porcentuales y [%p].</p>
			</text>
		</region>
		<region region-id="103" left="30" top="4892.25" width="650.25" height="12" align-x="30" align-y="4902" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
