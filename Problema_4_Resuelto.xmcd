		</region>
		<region region-id="52" left="498" top="1785" width="54" height="16.5" align-x="518.25" align-y="1794" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="2.4">f</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.019360179448835724</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="41"/>
		</region>
		<region region-id="53" left="30" top="1820.25" width="650.25" height="36" align-x="30" align-y="1830" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">F) Balance de Etanol en el reciclo acuoso (Componente 5):</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>En el caso base, no hay recirculación de agua desde T2 (beta_2 = 1.0), por lo que f&lt;2&gt;_5 = 0.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>Para generalidad paramétrica: C_5 := (1 - beta_2) * LK2; f&lt;2&gt;_5 := (C_5 * xi_1) / (1 - C_5).</p>
			</text>
		</region>
		<region region-id="54" left="30" top="1893" width="79.5" height="16.5" align-x="47.25" align-y="1902" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="5">C</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:parens>
							<ml:apply>
								<ml:minus/>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve" subscript="2">β</ml:id>
							</ml:apply>
						</ml:parens>
						<ml:id xml:space="preserve" subscript="2">LK</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="42"/>
		</region>
		<region region-id="55" left="210" top="1882.5" width="100.5" height="35.25" align-x="231.75" align-y="1902" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
