		</region>
		<region region-id="48" left="30" top="2168.25" width="650.25" height="60" align-x="30" align-y="2178" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">E) Balance de Acetaldehído en el reciclo gaseoso (Componente 4):</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>En el reactor: f&lt;3&gt;_4 = f&lt;2&gt;_4 + xi_2.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>En la torre T1: HK = Acetaldehído, una fracción HK1 pasa a cabeza (f&lt;5&gt;_4 = HK1 * f&lt;3&gt;_4).</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>En S1: f&lt;7&gt;_4 = (1 - beta_1) * HK1 * (f&lt;2&gt;_4 + xi_2).</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="3"/>Definiendo C_4 := (1 - beta_1) * HK1:<sp count="3"/>f&lt;2&gt;_4 = (C_4 * xi_2) / (1 - C_4).</p>
			</text>
		</region>
		<region region-id="49" left="30" top="2319" width="81" height="16.5" align-x="47.25" align-y="2328" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="4">C</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:parens>
							<ml:apply>
								<ml:minus/>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve" subscript="1">β</ml:id>
							</ml:apply>
						</ml:parens>
						<ml:id xml:space="preserve" subscript="1">HK</ml:id>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="38"/>
		</region>
