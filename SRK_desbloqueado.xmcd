		<region region-id="199" left="714" top="5.25" width="439.5" height="1106.25" align-x="714" align-y="18" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 1" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Ecuación de estado de Soave - Redlich - Kwong (SRK)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">@Hector Macaño, Gustavo Servetti, Jose Fonseca</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">UTN - FRC - Dpto. Ing. Química (2010 - 2019)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Este archivo sólo tiene fines educativos y los autores no tienen responsabilidad por su uso.</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Descripción:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Todas las variables deben ser adimensionales (en MathCad)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">El cálculo se realiza con el parámetro de interacción k<sub>ij</sub>=0</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Para evaluación de propiedades de mezcla:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<region region-id="54" left="714" top="144.75" width="108" height="16.5" align-x="747" align-y="153.75" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
								<ml:id xml:space="preserve" subscript="V.SRK">ϕ</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">y</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
									<ml:id xml:space="preserve">P</ml:id>
									<ml:id xml:space="preserve" subscript="c">T</ml:id>
									<ml:id xml:space="preserve" subscript="c">P</ml:id>
									<ml:id xml:space="preserve">ω</ml:id>
								</ml:sequence>
							</ml:apply>
						</math>
						<rendering item-idref="3"/>
					</region>
					<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">
						<f family="Arial" charset="0" size="10"> Coeficiente de fugacidad de la mezcla gaseosa</f>
					</inlineAttr>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<region region-id="55" left="714" top="162" width="105.75" height="16.5" align-x="746.25" align-y="171" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
								<ml:id xml:space="preserve" subscript="L.SRK">ϕ</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">x</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
									<ml:id xml:space="preserve">P</ml:id>
									<ml:id xml:space="preserve" subscript="c">T</ml:id>
									<ml:id xml:space="preserve" subscript="c">P</ml:id>
									<ml:id xml:space="preserve">ω</ml:id>
								</ml:sequence>
							</ml:apply>
						</math>
						<rendering item-idref="4"/>
					</region>
					<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">
						<f family="Arial" charset="0" size="10"> Coeficiente de fugacidad de la mezcla líquida</f>
					</inlineAttr>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<inlineAttr font-weight="normal" font-style="normal" underline="false" line-through="false">
						<f family="Arial" charset="0" size="10">Devuelven un vector (Nc x 1), adimensional</f>
					</inlineAttr>
				</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit"/>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<region region-id="56" left="714" top="203.25" width="107.25" height="16.5" align-x="746.25" align-y="212.25" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
						<math optimize="false" disable-calc="false">
							<ml:apply xmlns:ml="http://schemas.mathsoft.com/math30">
