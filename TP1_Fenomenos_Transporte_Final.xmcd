			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">11. Rango de Temperatura y Variables para Gráficos (270 K a 500 K)</p>
			</text>
		</region>
		<region region-id="101" left="42" top="3344.25" width="540" height="12" align-x="42" align-y="3354" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Definición de rangos de temperatura con y sin unidades para graficar:</p>
			</text>
		</region>
		<region region-id="102" left="42" top="3375" width="102" height="12.75" align-x="54.75" align-y="3384" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define warning="WarnRedefinedBIUnit" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">T</ml:id>
					<ml:sequence>
						<ml:apply>
							<ml:mult/>
							<ml:real>270</ml:real>
							<ml:id xml:space="preserve">K</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:real>275</ml:real>
							<ml:id xml:space="preserve">K</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:real>500</ml:real>
							<ml:id xml:space="preserve">K</ml:id>
						</ml:apply>
					</ml:sequence>
				</ml:define>
			</math>
			<rendering item-idref="64"/>
		</region>
		<region region-id="103" left="258" top="3375" width="81" height="16.5" align-x="281.25" align-y="3384" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve" subscript="ad">T</ml:id>
					<ml:sequence>
						<ml:real>270</ml:real>
						<ml:real>275</ml:real>
						<ml:real>500</ml:real>
					</ml:sequence>
				</ml:define>
			</math>
			<rendering item-idref="65"/>
		</region>
		<region region-id="104" left="42" top="3422.25" width="540" height="12" align-x="42" align-y="3432" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
