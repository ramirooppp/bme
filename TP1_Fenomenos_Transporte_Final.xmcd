		<region region-id="15" left="42" top="512.25" width="540" height="12" align-x="42" align-y="522" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Correlación: log10(mu / cP) = A + B/(T/K) + C*(T/K) + D*(T/K)^2</p>
