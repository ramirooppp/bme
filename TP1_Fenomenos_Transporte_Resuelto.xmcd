            <ml:id xml:space="preserve" subscript="1">cp</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:div /><ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>258.507</ml:real><ml:apply><ml:mult /><ml:real>1.3429</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-0.0034546</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>4.0075e-06</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">joule</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">mole</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:id xml:space="preserve" subscript="1">MW</ml:id></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="38" left="40" top="1470" width="500" height="30" align-x="40" align-y="1488" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="2">cp</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:div /><ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>266.096</ml:real><ml:apply><ml:mult /><ml:real>1.4888</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-0.0037813</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>4.2498e-06</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">joule</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">mole</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:id xml:space="preserve" subscript="2">MW</ml:id></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="39" left="40" top="1520" width="500" height="30" align-x="40" align-y="1538" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="3">cp</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:div /><ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>89.101</ml:real><ml:apply><ml:mult /><ml:real>2.7062</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-0.0061478</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>5.752e-06</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">joule</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">mole</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:id xml:space="preserve" subscript="3">MW</ml:id></ml:apply>
    </ml:define>
