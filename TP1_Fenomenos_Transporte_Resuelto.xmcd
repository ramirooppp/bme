            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:mult /><ml:real>0.2435</ml:real><ml:apply><ml:pow /><ml:real>0.2544</ml:real><ml:parens><ml:apply><ml:neg /><ml:apply><ml:pow /><ml:parens><ml:apply><ml:minus /><ml:real>1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:apply><ml:mult /><ml:real>720.6</ml:real><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply></ml:parens><ml:real>0.3238</ml:real></ml:apply></ml:apply></ml:parens></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>1000</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">kg</ml:id><ml:apply><ml:pow /><ml:id xml:space="preserve">m</ml:id><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="30" left="40" top="1112" width="540" height="22" align-x="40" align-y="1128" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">5. Conductividad Térmica de Líquidos Puros (Yaws 2003)</p>
            </text>
        </region><region region-id="31" left="40" top="1147" width="540" height="20" align-x="40" align-y="1161" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Correlación: k = (A + B*(T/K) + C*(T/K)^2) [W/(m*K)]</p>
            </text>
        </region><region region-id="32" left="40" top="1177" width="450" height="30" align-x="40" align-y="1195" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="1">k</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>0.1496</ml:real><ml:apply><ml:mult /><ml:real>-3.938e-05</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-1.9208e-07</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">watt</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">m</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="33" left="40" top="1227" width="450" height="30" align-x="40" align-y="1245" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="2">k</ml:id>
