        </ml:function>
        <ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>0.1461</ml:real><ml:apply><ml:mult /><ml:real>-3.2788e-05</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-1.8813e-07</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">watt</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">m</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="34" left="40" top="1277" width="450" height="30" align-x="40" align-y="1295" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="3">k</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>0.189</ml:real><ml:apply><ml:mult /><ml:real>-0.00012226</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-1.3059e-07</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens><ml:apply><ml:div /><ml:id xml:space="preserve">watt</ml:id><ml:apply><ml:mult /><ml:id xml:space="preserve">m</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="35" left="40" top="1355" width="540" height="22" align-x="40" align-y="1371" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">6. Calor Específico Másico de Líquidos Puros (Yaws 2003)</p>
            </text>
        </region><region region-id="36" left="40" top="1390" width="540" height="20" align-x="40" align-y="1404" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Correlación: cp_masico = (A + B*(T/K) + C*(T/K)^2 + D*(T/K)^3) / MW [J/(kg*K)]</p>
            </text>
        </region><region region-id="37" left="40" top="1420" width="500" height="30" align-x="40" align-y="1438" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
