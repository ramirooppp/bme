            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">3. Viscosidad de Líquidos Puros (Yaws 2003)</p>
            </text>
        </region><region region-id="15" left="40" top="505" width="540" height="20" align-x="40" align-y="519" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Correlación: log10(mu / cP) = A + B/(T/K) + C*(T/K) + D*(T/K)^2</p>
            </text>
        </region><region region-id="16" left="40" top="533" width="540" height="20" align-x="40" align-y="547" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Matriz de coeficientes de viscosidad [A, B, C, D] para los 3 hidrocarburos:</p>
            </text>
        </region><region region-id="17" left="40" top="563" width="80" height="30" align-x="40" align-y="581" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="visc">A</ml:id><ml:matrix rows="3" cols="1"><ml:real>-5.0263</ml:real><ml:real>-4.9814</ml:real><ml:real>-8.1894</ml:real></ml:matrix></ml:define>
            </math>
        </region><region region-id="18" left="160" top="563" width="80" height="30" align-x="160" align-y="581" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="visc">B</ml:id><ml:matrix rows="3" cols="1"><ml:real>1034.3</ml:real><ml:real>1056.5</ml:real><ml:real>1557.1</ml:real></ml:matrix></ml:define>
            </math>
        </region><region region-id="19" left="280" top="563" width="80" height="30" align-x="280" align-y="581" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="visc">C</ml:id><ml:matrix rows="3" cols="1"><ml:real>0.0087</ml:real><ml:real>0.0084</ml:real><ml:real>0.0153</ml:real></ml:matrix></ml:define>
            </math>
        </region><region region-id="20" left="400" top="563" width="90" height="30" align-x="400" align-y="581" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="visc">D</ml:id><ml:matrix rows="3" cols="1"><ml:real>-8.276e-06</ml:real><ml:real>-7.9353e-06</ml:real><ml:real>-1.2371e-05</ml:real></ml:matrix></ml:define>
            </math>
        </region><region region-id="21" left="40" top="663" width="540" height="20" align-x="40" align-y="677" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Funciones de Viscosidad con unidades nativas:</p>
            </text>
        </region><region region-id="22" left="40" top="691" width="500" height="30" align-x="40" align-y="709" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="1">mu</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:pow /><ml:real>10</ml:real><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>-5.0263</ml:real><ml:apply><ml:div /><ml:real>1034.3</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>0.0087</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-8.276e-06</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="23" left="40" top="741" width="500" height="30" align-x="40" align-y="759" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="2">mu</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:pow /><ml:real>10</ml:real><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>-4.9814</ml:real><ml:apply><ml:div /><ml:real>1056.5</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>0.0084</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-7.9353e-06</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="24" left="40" top="791" width="500" height="30" align-x="40" align-y="809" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="3">mu</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:pow /><ml:real>10</ml:real><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:real>-8.1894</ml:real><ml:apply><ml:div /><ml:real>1557.1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>0.0153</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>-1.2371e-05</ml:real><ml:apply><ml:pow /><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:id xml:space="preserve">K</ml:id></ml:apply><ml:real>2</ml:real></ml:apply></ml:apply></ml:apply></ml:parens></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="25" left="40" top="869" width="540" height="22" align-x="40" align-y="885" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">4. Densidad de Líquidos Puros (Yaws 2003)</p>
            </text>
        </region><region region-id="26" left="40" top="904" width="540" height="20" align-x="40" align-y="918" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Correlación: rho = A * B^(-(1 - T/Tc)^n) [g/cm^3]</p>
            </text>
        </region><region region-id="27" left="40" top="934" width="450" height="30" align-x="40" align-y="952" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="1">rho</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:mult /><ml:real>0.246</ml:real><ml:apply><ml:pow /><ml:real>0.2617</ml:real><ml:parens><ml:apply><ml:neg /><ml:apply><ml:pow /><ml:parens><ml:apply><ml:minus /><ml:real>1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:apply><ml:mult /><ml:real>683.39</ml:real><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply></ml:parens><ml:real>0.2857</ml:real></ml:apply></ml:apply></ml:parens></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>1000</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">kg</ml:id><ml:apply><ml:pow /><ml:id xml:space="preserve">m</ml:id><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="28" left="40" top="984" width="450" height="30" align-x="40" align-y="1002" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="2">rho</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:mult /><ml:apply><ml:mult /><ml:real>0.2463</ml:real><ml:apply><ml:pow /><ml:real>0.2613</ml:real><ml:parens><ml:apply><ml:neg /><ml:apply><ml:pow /><ml:parens><ml:apply><ml:minus /><ml:real>1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">T</ml:id><ml:apply><ml:mult /><ml:real>695.62</ml:real><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:apply></ml:apply></ml:parens><ml:real>0.2857</ml:real></ml:apply></ml:apply></ml:parens></ml:apply></ml:apply><ml:apply><ml:mult /><ml:real>1000</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve">kg</ml:id><ml:apply><ml:pow /><ml:id xml:space="preserve">m</ml:id><ml:real>3</ml:real></ml:apply></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="29" left="40" top="1034" width="450" height="30" align-x="40" align-y="1052" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
