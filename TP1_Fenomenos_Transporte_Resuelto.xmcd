        </region><region region-id="40" left="40" top="1598" width="540" height="22" align-x="40" align-y="1614" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">7. Inciso b) Determinación de la Composición Molar de la Mezcla</p>
            </text>
        </region><region region-id="41" left="40" top="1633" width="540" height="20" align-x="40" align-y="1647" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Valores experimentales dados por el enunciado:</p>
            </text>
        </region><region region-id="42" left="40" top="1661" width="110" height="30" align-x="40" align-y="1679" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="exp1">T</ml:id><ml:apply><ml:mult /><ml:real>273</ml:real><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:define>
            </math>
        </region><region region-id="43" left="170" top="1661" width="120" height="30" align-x="170" align-y="1679" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="exp1">mu</ml:id><ml:apply><ml:mult /><ml:real>4.053</ml:real><ml:id xml:space="preserve">cP</ml:id></ml:apply></ml:define>
            </math>
        </region><region region-id="44" left="310" top="1661" width="110" height="30" align-x="310" align-y="1679" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="exp2">T</ml:id><ml:apply><ml:mult /><ml:real>340</ml:real><ml:id xml:space="preserve">K</ml:id></ml:apply></ml:define>
            </math>
        </region><region region-id="45" left="440" top="1661" width="120" height="30" align-x="440" align-y="1679" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="exp2">mu</ml:id><ml:apply><ml:mult /><ml:real>1.167</ml:real><ml:id xml:space="preserve">cP</ml:id></ml:apply></ml:define>
            </math>
        </region><region region-id="46" left="40" top="1706" width="540" height="20" align-x="40" align-y="1720" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Matriz del sistema M (orden columna) y vector término independiente b:</p>
            </text>
        </region><region region-id="47" left="40" top="1734" width="220" height="30" align-x="40" align-y="1752" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve">M</ml:id><ml:matrix rows="3" cols="3"><ml:real>1</ml:real><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="1">mu</ml:id><ml:id xml:space="preserve" subscript="exp1">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="1">mu</ml:id><ml:id xml:space="preserve" subscript="exp2">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:real>1</ml:real><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="2">mu</ml:id><ml:id xml:space="preserve" subscript="exp1">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="2">mu</ml:id><ml:id xml:space="preserve" subscript="exp2">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:real>1</ml:real><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="3">mu</ml:id><ml:id xml:space="preserve" subscript="exp1">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:apply><ml:div /><ml:apply><ml:id xml:space="preserve" subscript="3">mu</ml:id><ml:id xml:space="preserve" subscript="exp2">T</ml:id></ml:apply><ml:id xml:space="preserve">cP</ml:id></ml:apply></ml:matrix></ml:define>
            </math>
        </region><region region-id="48" left="300" top="1734" width="120" height="30" align-x="300" align-y="1752" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve">b</ml:id><ml:matrix rows="3" cols="1"><ml:real>1</ml:real><ml:apply><ml:div /><ml:id xml:space="preserve" subscript="exp1">mu</ml:id><ml:id xml:space="preserve">cP</ml:id></ml:apply><ml:apply><ml:div /><ml:id xml:space="preserve" subscript="exp2">mu</ml:id><ml:id xml:space="preserve">cP</ml:id></ml:apply></ml:matrix></ml:define>
            </math>
        </region><region region-id="49" left="40" top="1829" width="540" height="20" align-x="40" align-y="1843" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Resolución matricial exacta en Mathcad:  x := M^-1 * b</p>
            </text>
        </region><region region-id="50" left="40" top="1857" width="140" height="30" align-x="40" align-y="1875" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve">x</ml:id><ml:apply><ml:mult /><ml:apply><ml:pow /><ml:id xml:space="preserve">M</ml:id><ml:real>-1</ml:real></ml:apply><ml:id xml:space="preserve">b</ml:id></ml:apply></ml:define>
            </math>
        </region><region region-id="51" left="220" top="1857" width="120" height="30" align-x="220" align-y="1875" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:eval placeholderMultiplicationStyle="default"><ml:id xml:space="preserve">x</ml:id></ml:eval>
            </math>
        </region><region region-id="52" left="40" top="1947" width="540" height="20" align-x="40" align-y="1961" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fracciones molares individuales calculadas:</p>
            </text>
        </region><region region-id="53" left="40" top="1975" width="80" height="30" align-x="40" align-y="1993" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="1">x</ml:id><ml:apply><ml:indexer /><ml:id xml:space="preserve">x</ml:id><ml:real>1</ml:real></ml:apply></ml:define>
            </math>
        </region><region region-id="54" left="180" top="1975" width="80" height="30" align-x="180" align-y="1993" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="2">x</ml:id><ml:apply><ml:indexer /><ml:id xml:space="preserve">x</ml:id><ml:real>2</ml:real></ml:apply></ml:define>
            </math>
        </region><region region-id="55" left="320" top="1975" width="80" height="30" align-x="320" align-y="1993" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="3">x</ml:id><ml:apply><ml:indexer /><ml:id xml:space="preserve">x</ml:id><ml:real>3</ml:real></ml:apply></ml:define>
            </math>
        </region><region region-id="56" left="40" top="2043" width="540" height="22" align-x="40" align-y="2059" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">8. Inciso c) Modelos y Estimación de Propiedades de la Mezcla</p>
            </text>
        </region><region region-id="57" left="40" top="2078" width="540" height="20" align-x="40" align-y="2092" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <text use-page-width="false" push-down="false" lock-width="true">
                <p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Definición de funciones de mezcla con comportamiento ideal:</p>
            </text>
        </region><region region-id="58" left="40" top="2108" width="450" height="30" align-x="40" align-y="2126" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="M">mu</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="1">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="1">mu</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="2">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="2">mu</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="3">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="3">mu</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="59" left="40" top="2153" width="350" height="30" align-x="40" align-y="2171" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define><ml:id xml:space="preserve" subscript="M">MW</ml:id><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="1">x</ml:id><ml:id xml:space="preserve" subscript="1">MW</ml:id></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="2">x</ml:id><ml:id xml:space="preserve" subscript="2">MW</ml:id></ml:apply></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="3">x</ml:id><ml:id xml:space="preserve" subscript="3">MW</ml:id></ml:apply></ml:apply></ml:define>
            </math>
        </region><region region-id="60" left="40" top="2198" width="450" height="30" align-x="40" align-y="2216" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="M">rho</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:div /><ml:id xml:space="preserve" subscript="M">MW</ml:id><ml:parens><ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:div /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="1">x</ml:id><ml:id xml:space="preserve" subscript="1">MW</ml:id></ml:apply><ml:apply><ml:id xml:space="preserve" subscript="1">rho</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply><ml:apply><ml:div /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="2">x</ml:id><ml:id xml:space="preserve" subscript="2">MW</ml:id></ml:apply><ml:apply><ml:id xml:space="preserve" subscript="2">rho</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:div /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="3">x</ml:id><ml:id xml:space="preserve" subscript="3">MW</ml:id></ml:apply><ml:apply><ml:id xml:space="preserve" subscript="3">rho</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply></ml:parens></ml:apply>
    </ml:define>
            </math>
        </region><region region-id="61" left="40" top="2248" width="450" height="30" align-x="40" align-y="2266" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
            <math optimize="false" disable-calc="false">
                <ml:define>
        <ml:function>
            <ml:id xml:space="preserve" subscript="M">k</ml:id>
            <ml:boundVars><ml:id xml:space="preserve">T</ml:id></ml:boundVars>
        </ml:function>
        <ml:apply><ml:plus /><ml:apply><ml:plus /><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="1">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="1">k</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="2">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="2">k</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply><ml:apply><ml:mult /><ml:id xml:space="preserve" subscript="3">x</ml:id><ml:apply><ml:id xml:space="preserve" subscript="3">k</ml:id><ml:id xml:space="preserve">T</ml:id></ml:apply></ml:apply></ml:apply>
    </ml:define>
