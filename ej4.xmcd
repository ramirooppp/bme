		<region region-id="532" left="528" top="3740.25" width="800.25" height="48" align-x="528" align-y="3750" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">DEMOSTRACIÓN DE CONSISTENCIA DEL BALANCE GLOBAL DE MASA (INCISO E):</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Verificamos rigurosamente que la masa total que ingresa a la planta es idéntica a la que sale:</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="2"/>- Entradas: F1 (gases frescos) + F14 (agua pura de reposición)</p>
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<sp count="2"/>- Salidas: F6 (purga gas) + F11 (subproducto) + F13 (etanol producto) + F12 (residuo acuoso T4) + F15 (purga agua T2)</p>
			</text>
		</region>
		<region region-id="533" left="528" top="3831" width="92.25" height="16.5" align-x="552" align-y="3840" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
