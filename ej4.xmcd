					<ml:id xml:space="preserve" subscript="in">W</ml:id>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:id xml:space="preserve">W</ml:id>
							<ml:real>1</ml:real>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">W</ml:id>
							<ml:real>14</ml:real>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="125"/>
		</region>
