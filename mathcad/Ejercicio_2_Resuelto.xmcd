			</math>
			<rendering item-idref="23"/>
		</region>
		<region region-id="138" left="48" top="890.25" width="249.75" height="12" align-x="48" align-y="900" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
