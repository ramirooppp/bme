		<region region-id="118" left="48" top="440.25" width="249.75" height="12" align-x="48" align-y="450" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fugacidad de puros f_puro = ϕ_puro * P (bar):</p>
			</text>
		</region>
		<region region-id="119" left="318" top="440.25" width="249.75" height="12" align-x="318" align-y="450" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Fugacidad Benceno(1) en mezcla f1_hat (bar):</p>
			</text>
		</region>
		<region region-id="120" left="48" top="442.5" width="199.5" height="45.75" align-x="201" align-y="468" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
